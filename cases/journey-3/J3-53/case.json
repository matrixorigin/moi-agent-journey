          "rag_reference": {
            "status": "reviewed",
            "criteria": [
              {
                "id": "C01",
                "text": "按资料解释Catalog是工作区资源组织/管理入口"
              },
              {
                "id": "C02",
                "text": "区分目录、数据库/表、卷/文件的实际层次和访问边界，不把Catalog等同于某个单独的表，也不扩展成无关流程"
              }
