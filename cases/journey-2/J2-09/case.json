{
  "schema_version": 1,
  "id": "J2-09",
  "workspace": "journey-2",
  "title": "创建绑定 XLSX Skill 的智能体并生成表格",
  "executor": "api",
  "source": {
    "benchmark": "MOI product journey"
  },
  "assets": [],
  "oracles": [],
  "random_tokens": [
    "agent_name",
    "filename",
    "content"
  ],
  "builder_names": [
    "agent_name"
  ],
  "sessions": [
    {
      "id": "builder",
      "delivery_kind": "agent",
      "expected_checks": 8,
      "turns": [
        {
          "phase": "propose",
          "prompt": "请创建一个名为 {agent_name} 的智能体，专门生成 Excel 表格，请明确绑定 xlsx 技能（moi.agent.momo.skill.xlsx）。先展示候选，暂时不要确认创建。",
          "action": {
            "type": "commit_builder_with_resource",
            "agent_name": "{agent_name}",
            "resource_kind": "skills",
            "resource_id": "moi.agent.momo.skill.xlsx"
          }
        }
      ]
    },
    {
      "id": "skill_agent",
      "agent_from": "builder",
      "delivery_kind": "file",
      "expected_checks": 4,
      "turns": [
        {
          "phase": "generate",
          "prompt": "请生成一个名为 {filename}.xlsx 的 Excel 文件，在第一个工作表的 A1 单元格填入 {content}，然后交付这个文件。",
          "action": {
            "type": "deliver_xlsx_with_skill",
            "skill_id": "moi.agent.momo.skill.xlsx",
            "filename": "{filename}.xlsx",
            "content": "{content}"
          }
        }
      ]
    }
  ]
}
