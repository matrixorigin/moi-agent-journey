{
  "schema_version": 1,
  "id": "J2-52",
  "workspace": "journey-2",
  "title": "智能体禁用、恢复及恢复后对话",
  "executor": "api",
  "source": {
    "benchmark": "MOI product journey"
  },
  "assets": [],
  "oracles": [],
  "random_tokens": [
    "agent_name",
    "marker"
  ],
  "builder_names": [
    "agent_name"
  ],
  "sessions": [
    {
      "id": "builder",
      "delivery_kind": "agent",
      "expected_checks": 13,
      "turns": [
        {
          "phase": "create",
          "prompt": "请创建一个名为 {agent_name} 的智能体，职责是原样复述用户输入的短文本。先展示候选，暂时不要确认创建。",
          "action": {
            "type": "create_builder_agent_and_check_lifecycle",
            "agent_name": "{agent_name}"
          }
        }
      ]
    },
    {
      "id": "restored",
      "agent_from": "builder",
      "delivery_kind": "answer",
      "expected_checks": 2,
      "turns": [
        {
          "phase": "chat",
          "prompt": "请原样回复标记：{marker}",
          "assertions": [
            {
              "type": "contains",
              "value": "{marker}",
              "rule": "恢复后的智能体可以正常对话"
            }
          ]
        }
      ]
    }
  ]
}
