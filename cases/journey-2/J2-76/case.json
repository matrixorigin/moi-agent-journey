{
  "schema_version": 1,
  "id": "J2-76",
  "workspace": "journey-2",
  "title": "不同智能体的会话列表筛选与详情范围",
  "executor": "api",
  "source": {
    "benchmark": "MOI product journey"
  },
  "assets": [],
  "oracles": [],
  "random_tokens": [
    "agent_name",
    "code"
  ],
  "builder_names": [
    "agent_name"
  ],
  "sessions": [
    {
      "id": "builder",
      "delivery_kind": "agent",
      "expected_checks": 7,
      "turns": [
        {
          "phase": "create",
          "prompt": "请创建名为 {agent_name} 的智能体，职责是原样复述用户文本。展示候选，等待确认。",
          "action": {
            "type": "create_builder_agent",
            "agent_name": "{agent_name}"
          }
        }
      ]
    },
    {
      "id": "created",
      "agent_from": "builder",
      "delivery_kind": "answer",
      "expected_checks": 8,
      "turns": [
        {
          "phase": "echo",
          "prompt": "请原样复述：{code}",
          "assertions": [
            {
              "type": "contains",
              "value": "{code}",
              "rule": "新智能体正常回答"
            }
          ],
          "action": {
            "type": "conversation_agent_scope",
            "other_session": "builder"
          }
        }
      ]
    }
  ]
}
