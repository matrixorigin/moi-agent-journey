        },
        "create_table": {
          "name": "orders",
          "tableColumn": [
            {
              "column": "department",
              "dataType": "VARCHAR",
              "precision": [
                255
              ],
              "col_num_in_file": 1
            },
            {
              "column": "amount",
              "dataType": "INT",
              "col_num_in_file": 2
            }
          ]
        }
      },
      "verification": {
        "sum_column": "amount",
        "filter_column": "department",
        "filter_value": "atlas",
        "expected_rows": 3,
        "expected_sum": 115
      }
    }
  },
  "sessions": [
    {
      "id": "citations",
      "delivery_kind": "answer",
      "expected_checks": 12,
      "turns": [
        {
          "phase": "pdf",
          "prompt": "请根据我选择的知识库，回答第二页 Record identifier 的值，并引用该 PDF 来源。",
