        {
          "phase": "table",
          "prompt": "请根据现在选择的知识库，统计 orders 表 atlas 部门的 amount 总额，回答合计并引用 SQL 来源。",
          "knowledge_selection": [
            "table"
          ],
          "knowledge_table_evidence": "table",
          "citation_open": "table",
          "assertions": [
            {
              "type": "number_present",
