{
  "schema_version": 1,
  "id": "J2-122",
  "workspace": "journey-2",
  "title": "恢复智能体时校验 skill 禁用和删除依赖",
  "executor": "api",
  "source": {
    "benchmark": "MOI resource lifecycle regression",
    "issues": [
      "https://github.com/matrixorigin/matrixflow/issues/19250",
      "https://github.com/matrixorigin/matrixflow/issues/19944"
    ]
  },
  "assets": [],
  "oracles": [],
  "random_tokens": [
    "ordinary_code"
  ],
  "resource_lifecycle": {
    "kind": "skill",
    "mode": "reactivation"
  },
  "sessions": [
    {
      "id": "before",
      "agent_from_lifecycle": true,
      "delivery_kind": "answer",
      "expected_checks": 20,
      "turns": [
        {
          "phase": "baseline",
          "prompt": "请实际读取 Skill {primary_id}（{primary_name}），告诉我其中的公开项目编号。不要用之前的回答代替本次读取。",
          "assertions": [
            {
              "type": "contains",
              "value": "{primary_marker}",
              "rule": "答复包含本次资源实际内容"
            }
          ],
          "lifecycle_check": "primary",
          "lifecycle_action": "disable_and_reactivate"
        }
      ]
    },
    {
      "id": "restored",
      "agent_from_lifecycle": true,
      "delivery_kind": "answer",
      "expected_checks": 9,
      "turns": [
        {
          "phase": "use",
          "prompt": "请实际读取 Skill {primary_id}（{primary_name}），告诉我其中的公开项目编号。不要用之前的回答代替本次读取。",
          "assertions": [
            {
              "type": "contains",
              "value": "{primary_marker}",
              "rule": "答复包含本次资源实际内容"
            }
          ],
          "lifecycle_check": "primary",
          "lifecycle_action": "delete_and_reactivate"
        }
      ]
    }
  ]
}
