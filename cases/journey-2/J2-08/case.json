{
  "schema_version": 1,
  "id": "J2-08",
  "workspace": "journey-2",
  "title": "追加对话修改并发布智能体候选",
  "executor": "api",
  "source": {
    "benchmark": "MOI product journey"
  },
  "assets": [],
  "oracles": [],
  "random_tokens": [
    "agent_name",
    "new_agent_name"
  ],
  "builder_names": [
    "agent_name",
    "new_agent_name"
  ],
  "sessions": [
    {
      "id": "builder",
      "delivery_kind": "agent",
      "expected_checks": 14,
      "turns": [
        {
          "phase": "propose",
          "prompt": "请创建一个名为 {agent_name} 的智能体，唯一职责是原样复述用户输入的文本。先展示候选，暂时不要确认创建。",
          "action": {
            "type": "capture_builder_candidate",
            "agent_name": "{agent_name}"
          }
        },
        {
          "phase": "revise",
          "prompt": "请把刚才尚未确认创建的智能体名称改成 {new_agent_name}，其他配置保持不变。先展示修改后的候选，暂时不要确认创建。",
          "action": {
            "type": "revise_builder_and_commit",
            "agent_name": "{new_agent_name}"
          }
        }
      ]
    }
  ]
}
