{
  "schema_version": 1,
  "id": "J2-16",
  "workspace": "journey-2",
  "title": "修改已发布智能体的技能和工具绑定",
  "executor": "api",
  "source": {"benchmark": "MOI product journey"},
  "assets": [],
  "oracles": [],
  "random_tokens": ["agent_name"],
  "builder_names": ["agent_name"],
  "sessions": [
    {
      "id": "builder",
      "delivery_kind": "agent",
      "expected_checks": 20,
      "turns": [
        {
          "phase": "create",
          "prompt": "请创建一个名为 {agent_name} 的智能体，专门生成 Excel 表格，请明确绑定 xlsx 技能（moi.agent.momo.skill.xlsx）。先展示候选，暂时不要确认创建。",
          "action": {
            "type": "commit_builder_with_resource",
            "agent_name": "{agent_name}",
            "resource_kind": "skills",
            "resource_id": "moi.agent.momo.skill.xlsx",
            "capture_current": true
          }
        },
        {
          "phase": "revise",
          "prompt": "请修改刚刚创建的智能体：移除 xlsx 技能（moi.agent.momo.skill.xlsx），添加联网搜索工具 moi_web_search。名称、模型、描述和其他配置保持不变。先展示修改后的候选，暂时不要确认。",
          "action": {
            "type": "revise_published_resources_and_commit",
            "agent_name": "{agent_name}",
            "resource_changes": {
              "skills": {"remove": ["moi.agent.momo.skill.xlsx"]},
              "tools": {"add": ["moi_web_search"]}
            }
          }
        }
      ]
    }
  ]
}
