    "benchmark": "MOI product journey"
  },
  "assets": [],
  "oracles": [],
  "fixtures": [
    {
      "path": "fern.txt",
      "sha256": "ff9910cebaffc659da675da07a4c035316a669c67999bdf8a6163e4ed2b9c414"
    },
    {
      "path": "birch.txt",
      "sha256": "ba93c40352bcae3dd35d91f7537bfd9aa629bc1e7f2f008cde7680465779a6c3"
    }
  ],
  "knowledge_fixtures": {
    "fern": {
      "kind": "document",
      "path": "fern.txt",
      "marker": "FERN-WALNUT"
    },
    "birch": {
      "kind": "document",
      "path": "birch.txt",
      "marker": "BIRCH-LEMON"
    }
  },
  "random_tokens": [
    "agent_name"
  ],
  "builder_names": [
    "agent_name"
  ],
  "sessions": [
    {
      "id": "builder",
      "delivery_kind": "agent",
      "expected_checks": 23,
      "turns": [
        {
          "phase": "create",
          "prompt": "请创建名为 {agent_name} 的智能体，专门回答知识库问题，明确绑定知识库 {fern_knowledge_name}（ID {fern_knowledge_id}）。先展示候选，暂时不要确认创建。",
          "action": {
            "type": "commit_builder_with_resource",
            "agent_name": "{agent_name}",
            "resource_kind": "knowledge_bases",
            "resource_id": "{fern_knowledge_id}",
            "capture_current": true
          }
        },
        {
          "phase": "revise",
          "prompt": "请修改刚刚创建的智能体：移除知识库 {fern_knowledge_name}（ID {fern_knowledge_id}），改为绑定知识库 {birch_knowledge_name}（ID {birch_knowledge_id}）。名称、模型、描述、指令和其他配置保持不变。先展示修改后的候选，暂时不要确认。",
          "action": {
            "type": "revise_published_resources_and_commit",
            "agent_name": "{agent_name}",
            "resource_changes": {
              "knowledge_bases": {
                "remove": [
                  "{fern_knowledge_id}"
                ],
                "add": [
                  "{birch_knowledge_id}"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "id": "query",
      "agent_from": "builder",
      "delivery_kind": "answer",
      "expected_checks": 4,
      "turns": [
        {
          "phase": "ask",
          "prompt": "请从绑定的知识库中查找 Project Birch 的 项目编号，回答准确编号并引用来源。",
          "knowledge_evidence": [
            "birch"
          ],
          "assertions": [
            {
              "type": "contains",
              "value": "BIRCH-LEMON",
              "rule": "新绑定的 Birch 知识库中的 项目编号 正确"
            }
          ]
        }
      ]
    }
  ]
